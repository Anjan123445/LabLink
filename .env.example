# ============================================================
# LabLink — Environment Configuration (.env.example)
# Note: Zero-config fallback is active by default.
# The application runs 100% locally even without any of these keys!
# ============================================================

# ── Google Gemini API Key (Optional) ────────────────────────
# Powers live natural-language project matching with gemini-2.5-flash.
# If omitted or invalid, the deterministic Offline Smart Engine automatically takes over.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Firebase Cloud Firestore Credentials (Optional) ─────────
# Enables global real-time synchronization and atomic transaction conflict checks.
# If omitted, LabLink operates seamlessly in Local Storage mode with cross-tab syncing.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
